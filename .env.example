APP_NAME="Nova Signal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Tehran
APP_URL=http://signal-telegram.test

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=signal_telegram
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE=default

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Production checklist (set these on the server)
# ---------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.com   # must be public HTTPS for Telegram webhooks
# QUEUE_CONNECTION=database

# Token for Python AI → Laravel signal API (Bearer or X-API-Token)
API_TOKEN=change-me-to-a-long-random-string

# Telegram bots (optional fallback; prefer Filament → ربات‌های تلگرام)
TELEGRAM_BOT_TOKEN_FA=
TELEGRAM_BOT_TOKEN_EN=
TELEGRAM_BOT_USERNAME_FA=YourFaBot
TELEGRAM_BOT_USERNAME_EN=YourEnBot

# Shared secret for webhook authenticity (1–256 chars: A–Z a–z 0–9 _ -)
# Telegram sends it as header X-Telegram-Bot-Api-Secret-Token
# Generate example: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
TELEGRAM_WEBHOOK_SECRET=

# Max Telegram API sends per second PER language queue (FA and EN separately)
TELEGRAM_BROADCAST_RATE=20

# Landing + bot checkout prices come from Filament → تنظیمات پرداخت VIP.
# These env values are only used as defaults when seeding PaymentSetting the first time.
PRICE_FOREX_USDT=49
PRICE_CRYPTO_USDT=49
PRICE_COMBO_USDT=79

# On-chain USDT verification (pending VIP payments)
# TRONGRID_API_KEY optional (higher rate limits). BSCSCAN_API_KEY required for BEP20.
TRONGRID_API_KEY=
BSCSCAN_API_KEY=
AUTO_CONFIRM_VERIFIED_TX=true
TX_AMOUNT_TOLERANCE=0.01

# Horizon UI path (Linux). Windows: use deploy/queue-work.bat with redis workers.
HORIZON_PATH=horizon
